{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [],
    "useUnknownInCatchVariables": true
  },
  "include": ["src/lib/**/*.ts", "src/worker/**/*.ts", "worker-configuration.d.ts"]
}
