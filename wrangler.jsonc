{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "churntop10-dev",
  "account_id": "f59b2545f5783d93b378006f3eb10bb4",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true }
  },
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "durable_objects": {
    "bindings": [{ "name": "TRADER", "class_name": "AccountTrader" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountTrader"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "churntop10-dev",
      "database_id": "7f0a12d3-f689-4a86-b30d-b349bdd77736",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "AUDIT", "bucket_name": "churntop10-audit-dev" }],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "tom2258@gmail.com"
    }
  ],
  "vars": {
    "ENVIRONMENT": "dev",
    "ALLOW_LIVE_TRADING": "0",
    "ACCESS_ENFORCE": "0",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "OWNER_EMAIL": "tom2258@gmail.com",
    "ZONE": "ycashlabs.com",
    "HOSTNAME": "top10-dev.ycashlabs.com",
    "ALLOWED_HOSTS": ""
  },
  "env": {
    "dev": {
      "name": "churntop10-dev",
      "workers_dev": false,
      "routes": [
        { "pattern": "desk-dev.churncapital.com", "custom_domain": true },
        { "pattern": "top10-dev.ycashlabs.com", "custom_domain": true }
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
      "durable_objects": {
        "bindings": [{ "name": "TRADER", "class_name": "AccountTrader" }]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "churntop10-dev",
          "database_id": "7f0a12d3-f689-4a86-b30d-b349bdd77736",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "AUDIT", "bucket_name": "churntop10-audit-dev" }],
      "send_email": [{ "name": "EMAIL", "destination_address": "tom2258@gmail.com" }],
      "vars": {
        "ENVIRONMENT": "dev",
        "ALLOW_LIVE_TRADING": "0",
        "ACCESS_ENFORCE": "1",
        "ACCESS_TEAM_DOMAIN": "dawn-rice-07a4",
        "ACCESS_AUD": "3826fb9770402e73a472a3e3519bcdbd4cdcbf79cc695141d3ffb9cdd8a2cdaa",
        "OWNER_EMAIL": "tom2258@gmail.com",
        "ZONE": "ycashlabs.com",
        "HOSTNAME": "desk-dev.churncapital.com",
        "ALLOWED_HOSTS": "top10-dev.ycashlabs.com"
      }
    },
    "prod": {
      "name": "churntop10-prod",
      "workers_dev": false,
      "routes": [{ "pattern": "top10.ycashlabs.com", "custom_domain": true }],
      "triggers": { "crons": ["*/5 * * * *"] },
      "durable_objects": {
        "bindings": [{ "name": "TRADER", "class_name": "AccountTrader" }]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "churntop10-prod",
          "database_id": "b2e4f00d-c7a2-41a6-a75f-12a3043ca20e",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "AUDIT", "bucket_name": "churntop10-audit-prod" }],
      "send_email": [{ "name": "EMAIL", "destination_address": "tom2258@gmail.com" }],
      "vars": {
        "ENVIRONMENT": "prod",
        "ALLOW_LIVE_TRADING": "0",
        "ACCESS_ENFORCE": "1",
        "ACCESS_TEAM_DOMAIN": "dawn-rice-07a4",
        "ACCESS_AUD": "b05d3bc57044f2fd02b7e9666d7e61a18e236784bdcbda9ea8322b9d6fe14517",
        "OWNER_EMAIL": "tom2258@gmail.com",
        "ZONE": "ycashlabs.com",
        "HOSTNAME": "top10.ycashlabs.com",
        "ALLOWED_HOSTS": ""
      }
    }
  }
}
