{
  "name": "churntop10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && wrangler d1 migrations apply DB --local && wrangler dev --env dev --port 8787",
    "build:client": "vite build",
    "build:worker": "node scripts/bundle-worker.mjs",
    "build": "npm run build:client && npm run build:worker",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "check:html": "node scripts/check-html.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@simplewebauthn/browser": "13.1.2",
    "@simplewebauthn/server": "13.1.2",
    "ajv": "8.17.1",
    "hono": "4.7.10",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@types/node": "^22.15.21",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.0",
    "esbuild": "0.25.5",
    "eslint": "9.28.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.1",
    "vite": "6.3.5",
    "vitest": "3.1.4",
    "wrangler": "4.20.0"
  }
}
