{
  "name": "churntop10",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/churndev/churntop10.git"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && wrangler d1 migrations apply DB --local && wrangler dev --port 8787 --ip 127.0.0.1",
    "build:client": "vite build && node scripts/embed-assets.mjs",
    "build:worker": "node scripts/bundle-worker.mjs",
    "build": "npm run build:client && npm run build:worker",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "node scripts/check-design.mjs && vitest run",
    "check:html": "node scripts/check-html.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "cf-typegen": "wrangler types",
    "check:design": "node scripts/check-design.mjs",
    "backfill:trade-signals": "node --experimental-strip-types scripts/backfill-trade-signals.mjs",
    "conformance": "node scripts/conformance.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "13.1.2",
    "@simplewebauthn/server": "13.1.2",
    "hono": "4.7.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.28.0",
    "@types/node": "^22.15.21",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.0",
    "ajv": "8.17.1",
    "esbuild": "0.25.5",
    "eslint": "9.28.0",
    "puppeteer-core": "^24.15.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.1",
    "vite": "6.3.5",
    "vitest": "3.1.4",
    "wrangler": "4.20.0"
  }
}
